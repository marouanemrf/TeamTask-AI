{
  "name": "teamtask-ai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "set-role": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/set-role.ps1",
    "test": "vitest run",
    "deploy:sandbox": "node scripts/deploy-sandbox.mjs",
    "seed:demo": "node scripts/align-demo-data.mjs",
    "security:setup": "tsx scripts/security/setup-test-users.ts",
    "test:security": "vitest run tests/security --no-file-parallelism --testTimeout=120000",
    "security:report": "node scripts/security/report.mjs"
  },
  "dependencies": {
    "@aws-amplify/ui-react": "^6.15.7",
    "@aws-sdk/client-lambda": "^3.1152.0",
    "@aws-sdk/client-sesv2": "^3.1152.0",
    "@aws-sdk/client-sfn": "^3.1152.0",
    "@aws-sdk/client-ssm": "^3.1152.0",
    "@dnd-kit/core": "^6.3.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "aws-amplify": "^6.22.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@aws-amplify/backend": "^1.25.1",
    "@aws-amplify/backend-cli": "^1.10.0",
    "@aws-sdk/client-appsync": "^3.1152.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1152.0",
    "@aws-sdk/client-cognito-identity": "^3.1152.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1152.0",
    "@aws-sdk/client-dynamodb": "^3.1152.0",
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/lib-dynamodb": "^3.1152.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "aws-cdk-lib": "^2.268.0",
    "constructs": "^10.8.1",
    "esbuild": "^0.28.2",
    "oxlint": "^1.81.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  }
}
